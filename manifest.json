{
  "manifest_version": 3,
  "name": "ChatGPT 下一问队列",
  "version": "1.0.2",
  "description": "在 ChatGPT 回复时按 Enter 将问题加入队列，回复结束后依次自动发送。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
